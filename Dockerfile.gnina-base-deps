# Base image with all gnina dependencies pre-installed
# This image is built once and reused for incremental builds
# Using CUDA 12.1 to match libtorch cu121
FROM --platform=linux/amd64 nvidia/cuda:12.1.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install ALL build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    unzip \
    cmake \
    libboost-all-dev \
    libeigen3-dev \
    libopenbabel-dev \
    libjsoncpp-dev \
    zlib1g-dev \
    libprotobuf-dev \
    protobuf-compiler \
    libhdf5-dev \
    librdkit-dev \
    python3 \
    python3-dev \
    python3-pip \
    python3-numpy \
    ccache \
    patchelf \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install pytest "cmake>=3.27,<4.0"

# Use pip-installed cmake (3.27+) and ccache
ENV PATH="/usr/local/bin:/usr/lib/ccache:$PATH"

# Download and install libtorch
WORKDIR /opt
RUN wget -q https://download.pytorch.org/libtorch/cu121/libtorch-cxx11-abi-shared-with-deps-2.1.2%2Bcu121.zip -O libtorch.zip && \
    unzip -q libtorch.zip && \
    rm libtorch.zip

# Clone and build libmolgrid
RUN git clone --depth 1 https://github.com/gnina/libmolgrid.git && \
    cd libmolgrid && \
    mkdir build && cd build && \
    cmake .. -DBUILD_PYTHON=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_CUDA_ARCHITECTURES="70;75;80;86;89" && \
    make -j$(nproc) && \
    make install

# Clone gnina source (will be overridden by volume mounts for modified files)
WORKDIR /gnina
RUN git clone --depth 1 https://github.com/gnina/gnina.git src

# Patch CMakeLists.txt to include bfgs_parallel.cu
RUN sed -i '/lib\/bfgs.cu/a lib\/bfgs_parallel.cu' /gnina/src/gninasrc/CMakeLists.txt

# Create build directory (will be a volume mount point)
RUN mkdir -p /gnina/build

ENV LD_LIBRARY_PATH=/opt/libtorch/lib:/usr/local/lib:$LD_LIBRARY_PATH

# Install ninja for faster builds
RUN apt-get update && apt-get install -y ninja-build && rm -rf /var/lib/apt/lists/*

WORKDIR /gnina/build
