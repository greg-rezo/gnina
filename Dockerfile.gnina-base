# Dockerfile for building gnina from source with our modifications
# Build the proper way: from top level with all dependencies
# Rebuild trigger: 2026-01-22
FROM --platform=linux/amd64 nvidia/cuda:12.2.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install ALL build dependencies (same as gnina's official build)
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    unzip \
    cmake \
    libboost-all-dev \
    libeigen3-dev \
    libopenbabel-dev \
    libjsoncpp-dev \
    zlib1g-dev \
    libprotobuf-dev \
    protobuf-compiler \
    libhdf5-dev \
    librdkit-dev \
    python3 \
    python3-dev \
    python3-pip \
    python3-numpy \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install pytest "cmake>=3.27,<4.0"

# Use pip-installed cmake (3.27+) for CUDA all-major support
ENV PATH="/usr/local/bin:$PATH"

# Download and install libtorch 2.4.0 (has setBlasPreferredBackend API for cuBLAS control)
WORKDIR /opt
RUN wget -q https://download.pytorch.org/libtorch/cu121/libtorch-cxx11-abi-shared-with-deps-2.4.0%2Bcu121.zip -O libtorch.zip && \
    unzip -q libtorch.zip && \
    rm libtorch.zip

# Clone and build libmolgrid
RUN git clone --depth 1 https://github.com/gnina/libmolgrid.git && \
    cd libmolgrid && \
    mkdir build && cd build && \
    cmake .. -DBUILD_PYTHON=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_CUDA_ARCHITECTURES="70;75;80;86;89" && \
    make -j$(nproc) && \
    make install

# Clone gnina source
WORKDIR /gnina
RUN git clone --depth 1 https://github.com/gnina/gnina.git src

# Copy our modified files
COPY gninasrc/lib/bfgs_parallel.h /gnina/src/gninasrc/lib/
COPY gninasrc/lib/bfgs_parallel.cu /gnina/src/gninasrc/lib/
COPY gninasrc/lib/user_opts.h /gnina/src/gninasrc/lib/
COPY gninasrc/main/main.cpp /gnina/src/gninasrc/main/

# Patch CMakeLists.txt to include bfgs_parallel.cu
RUN sed -i '/lib\/bfgs.cu/a lib\/bfgs_parallel.cu' /gnina/src/gninasrc/CMakeLists.txt

# Build gnina from TOP LEVEL (the intended way)
WORKDIR /gnina/src/build
RUN cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DLIBMOLGRID_LIBRARY=/usr/local/lib/libmolgrid.so \
    -DLIBMOLGRID_INCLUDE=/usr/local/include \
    -DCMAKE_PREFIX_PATH="/opt/libtorch" \
    -DCMAKE_CUDA_ARCHITECTURES="70;75;80;86;89" && \
    make -j$(nproc)

ENV LD_LIBRARY_PATH=/opt/libtorch/lib:/usr/local/lib:$LD_LIBRARY_PATH

CMD ["./gninasrc/gnina", "--help"]
